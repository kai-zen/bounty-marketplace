# Copy to apps/api/.env. Do not commit that copy.
# The API exits on startup if MONGODB_URI, RPC_URL, CHAIN_ID,
# FACTORY_ADDRESS, or REGISTRY_ADDRESS is missing or invalid.

# MongoDB from `docker compose up -d` at the repo root.
MONGODB_URI=mongodb://127.0.0.1:27017/bounty-marketplace

# Nest listen port. The Next.js app uses 3000.
PORT=3001

# Public base URL for metadata URIs: {API_PUBLIC_URL}/api/v1/metadata/{id}
API_PUBLIC_URL=http://localhost:3001

# Local Hardhat node (chain 31337).
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337

# packages/contracts/deployments/31337.json
FACTORY_ADDRESS=0xe7f1725E7734CE288F8367e1Bb143E90bb3F0512
REGISTRY_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3

# First block the indexer reads. 0 includes a local deploy.
INDEXER_START_BLOCK=0
